<!-- app/globals.css -->
@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  body {
    @apply bg-gray-50 text-gray-900;
  }
}

@layer components {
  .btn-primary {
    @apply bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded;
  }
}

@layer utilities {
  .text-balance {
    text-wrap: balance;
  }
  .bg-navy-gradient {
    background: linear-gradient(135deg, #082f49 0%, #1e3a8a 45%, #3b82f6 100%);
  }
  .bg-blue-green-gradient {
    background: linear-gradient(135deg, #1e40af 0%, #0ea5e9 45%, #10b981 100%);
  }
}

